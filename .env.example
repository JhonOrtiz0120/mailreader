# ─────────────────────────────────────────────────────────────────────────────
# SAFITE — Extractor de Facturas DIAN
# Copia este archivo a .env y completa con tus credenciales reales
# ─────────────────────────────────────────────────────────────────────────────

# Servidor
PORT=3000

# Concurrencia máxima de buzones a procesar simultáneamente (default: 10)
MAX_CONCURRENT_MAILBOXES=10

# Scheduler automático al arrancar (expresión cron, ej: "*/15 * * * *")
# Dejar vacío o comentar para deshabilitar el scheduler automático
# AUTO_SCHEDULE=*/15 * * * *

# Webhook opcional: URL donde se enviará el JSON de la extracción (sin buffers)
# WEBHOOK_URL=https://mi-erp.safite.com/api/dian/ingest

# ─────────────────────────────────────────────────────────────────────────────
# BUZONES DE CORREO (Multi-tenant)
# Convención: MAILBOX_<N>_<CAMPO>
# N = número secuencial (1, 2, 3...)
# ─────────────────────────────────────────────────────────────────────────────

# ── Buzón 1: IMAP (cPanel / Hostinger / servidor propio) ──────────────────────
MAILBOX_1_PROVIDER=imap
MAILBOX_1_LABEL=Cliente Ejemplo - cPanel
MAILBOX_1_EMAIL=facturas@miempresa.com
MAILBOX_1_HOST=mail.miempresa.com
MAILBOX_1_PORT=993
MAILBOX_1_USER=facturas@miempresa.com
MAILBOX_1_PASSWORD=mi_password_seguro
MAILBOX_1_TLS=true
MAILBOX_1_MAILBOX=INBOX
MAILBOX_1_ACTIVE=true

# ── Buzón 2: Microsoft 365 (Graph API — Client Credentials) ──────────────────
MAILBOX_2_PROVIDER=microsoft
MAILBOX_2_LABEL=Cliente Microsoft 365
MAILBOX_2_EMAIL=facturas@miempresa.onmicrosoft.com
MAILBOX_2_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MAILBOX_2_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MAILBOX_2_CLIENT_SECRET=tu_client_secret_de_azure
MAILBOX_2_ACTIVE=true

# ── Buzón 3: Google Workspace (OAuth2 con Refresh Token) ─────────────────────
MAILBOX_3_PROVIDER=google
MAILBOX_3_LABEL=Cliente Google Workspace
MAILBOX_3_EMAIL=facturas@miempresa.com
MAILBOX_3_AUTH_TYPE=oauth2
MAILBOX_3_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
MAILBOX_3_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
MAILBOX_3_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxx
MAILBOX_3_ACTIVE=true

# ── Buzón 4: Google Workspace (Service Account — impersonación) ───────────────
# MAILBOX_4_PROVIDER=google
# MAILBOX_4_LABEL=Cliente Google SA
# MAILBOX_4_EMAIL=facturas@dominio.com
# MAILBOX_4_AUTH_TYPE=service_account
# MAILBOX_4_SA_EMAIL=dian-extractor@proyecto.iam.gserviceaccount.com
# MAILBOX_4_SA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nxxxxxx\n-----END PRIVATE KEY-----
# MAILBOX_4_ACTIVE=true

# ─────────────────────────────────────────────────────────────────────────────
# TODO v2: Migración a Base de Datos
# Cuando se implemente la tabla safite_mailboxes en la BD del ERP:
# DATABASE_URL=postgresql://user:password@host:5432/safite_erp
# CREDENTIALS_ENCRYPTION_KEY=clave_aes_256_bits_en_hex
# ─────────────────────────────────────────────────────────────────────────────
